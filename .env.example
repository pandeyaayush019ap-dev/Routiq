# ==========================================
# Routiq Environment Configuration Example
# ==========================================

# Public Frontend Variables (Vite - prefixed with VITE_)
# Optional custom vector/raster tile URL for MapLibre (defaults to OpenStreetMap raster tiles)
VITE_MAP_STYLE_URL=""

# Optional backend API base URL for Phase 2 Antigravity integration (leave blank for local demo mode)
VITE_API_BASE_URL=""

# ==========================================
# Server-Side Variables (Antigravity Phase 2 Backend)
# ==========================================
# PostgreSQL + PostGIS connection string
DATABASE_URL="postgresql://user:password@localhost:5432/routiq_db"

# JWT Secret for session authentication
JWT_SECRET="replace-with-a-secure-256-bit-random-secret"

# Authorized VAHAN / ULIP API credentials
VAHAN_API_KEY=""
VAHAN_API_SECRET=""
VAHAN_API_ENDPOINT="https://api.gateway.gov.in/vahan"

# Dedicated Heavy Truck Routing Engine (Valhalla / OSRM)
ROUTING_ENGINE_URL="http://localhost:8002"

# Server Port
PORT=3000
