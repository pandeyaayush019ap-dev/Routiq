# ==============================================================================
# Routiq Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR PRODUCTION KEYS TO GIT.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=3001

# ==============================================================================
# Database Persistence (PostgreSQL with PostGIS)
# When omitted, Routiq falls back to an in-memory transactional store for testing.
# ==============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/routiq_db"

# ==============================================================================
# Authentication & Session Security
# Provide a strong, cryptographically secure 256-bit secret string.
# ==============================================================================
JWT_SECRET="replace-with-a-secure-256-bit-random-secret"

# ==============================================================================
# Heavy Commercial Vehicle Routing Engines
# ==============================================================================
# Self-hosted or Cloud Valhalla Engine with truck costing model:
VALHALLA_URL="http://localhost:8002"

# OpenRouteService API (driving-hgv profile):
OPENROUTESERVICE_API_KEY=""
OPENROUTESERVICE_URL="https://api.openrouteservice.org"

# OSRM Road Geometry Engine (defaults to public OSM demo router):
OSRM_URL="https://router.project-osrm.org"

# Mappls (MapmyIndia) Routing credentials for India:
MAPPLS_CLIENT_ID=""
MAPPLS_CLIENT_SECRET=""

# ==============================================================================
# Government VAHAN / ULIP Vehicle Registration Gateway
# When omitted, Routiq surfaces an explicit unconfigured status and provides
# manual vehicle specification entry for the driver.
# ==============================================================================
VAHAN_API_KEY=""
VAHAN_API_SECRET=""
VAHAN_API_ENDPOINT="https://api.gateway.gov.in/vahan"

# Unified Logistics Interface Platform (ULIP) credentials:
ULIP_USERNAME=""
ULIP_PASSWORD=""

# ==============================================================================
# GIS Intelligence & MapArc Integration
# ==============================================================================
# Esri ArcGIS Network Analyst API Key (ArcGIS / ArcMap StreetMap Premium):
ARCGIS_API_KEY=""

# OpenStreetMap Overpass API endpoint for commercial freight POIs:
OVERPASS_URL="https://overpass-api.de/api/interpreter"

# ==============================================================================
# Client Frontend Variables (Vite - prefixed with VITE_)
# ==============================================================================
# Optional custom vector/raster tile URL for MapLibre GL JS:
VITE_MAP_STYLE_URL=""

# Backend API Base URL (leave blank when using Vite proxy or Vercel rewrites):
VITE_API_BASE_URL=""
